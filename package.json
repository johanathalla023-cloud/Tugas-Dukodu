    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "20.14.15",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "tsx": "^4.23.13",
    "typescript": "5.6.3"
  }
}
